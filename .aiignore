# An .aiignore file follows the same syntax as a .gitignore file.
# .gitignore documentation: https://git-scm.com/docs/gitignore

# Compiled class file
target/
*.class

# Package Files
#*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# temp ignore
*.cache
*.diff
*.patch
*.tmp

# Log file
log/
logs/
*.log

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# hprof
*.hprof

# idea ignore
.idea/
out/
*.ipr
*.iml
*.iws

# eclipse ignore
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# VS Code
.vscode/

# system ignore
.DS_Store
Thumbs.db

# node ignore
node_modules
.turbo
dist
coverage
pnpm-lock.yaml

.flattened-pom.xml
